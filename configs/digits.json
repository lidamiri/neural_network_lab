{
  "name": "digits",
  "seed": 42,
  "dataset": {
    "name": "digits",
    "options": {
      "samples_per_class": 200,
      "size": 16,
      "noise": 0.1,
      "val_fraction": 0.15,
      "test_fraction": 0.15
    }
  },
  "architecture": [
    {"type": "dense", "units": 128, "activation": "relu", "initializer": "he_normal"},
    {"type": "batchnorm"},
    {"type": "dropout", "rate": 0.2},
    {"type": "dense", "units": 64, "activation": "relu", "initializer": "he_normal"},
    {"type": "dropout", "rate": 0.1},
    {"type": "dense", "units": 10, "activation": "softmax", "initializer": "xavier_normal"}
  ],
  "loss": "categorical_crossentropy",
  "l2": 0.0001,
  "optimizer": {"name": "adamw", "learning_rate": 0.002, "weight_decay": 0.01, "clip_norm": 5.0},
  "schedule": {"name": "cosine", "min_lr": 0.0001},
  "training": {
    "epochs": 60,
    "batch_size": 64,
    "shuffle": true,
    "patience": 12,
    "min_delta": 0.00001,
    "restore_best": true,
    "verbose": true
  }
}
